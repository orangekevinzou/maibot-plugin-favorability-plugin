{
  "manifest_version": 2,
  "version": "1.3.0",
  "name": "好感度插件 (Favorability Plugin)",
  "description": "麦麦的好感度追踪系统。通过 HookHandler 接收入站消息并缓存到文件，每 n 条消息调用 LLM 自动判断好感度变化，支持自然语言与命令查询，管理员可手动调整。好感度范围 -100~100，共 10 个等级。支持用户名识别。",
  "author": {
    "name": "orangekevinzou",
    "url": "https://github.com/orangekevinzou"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/orangekevinzou/maibot-plugin-favorability-plugin",
    "homepage": "https://github.com/orangekevinzou/maibot-plugin-favorability-plugin",
    "documentation": "https://github.com/orangekevinzou/maibot-plugin-favorability-plugin",
    "issues": "https://github.com/orangekevinzou/maibot-plugin-favorability-plugin"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.0.0"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.hybrid",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "orangekevinzou.favorability-plugin"
}
